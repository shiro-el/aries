#!/bin/sh
# Fake Agent for seam-1 tests (POSIX sh, runs on Linux and in the alpine sshd image).
#
# Usage: fake-agent SCRIPT
#   Runs SCRIPT one line per step, then keeps reading input until killed.
#   Every input line it reads is appended, exactly, to $FAKE_AGENT_INPUT
#   (default ./fake-agent.input), one per line.
#
# Steps:
#   status STATE [KIND|-] [MSG...]  report OSC 7501 (app=$FAKE_AGENT_APP, default "fake");
#                                   KIND is permission/question/auth, "-" for none
#   wait                            read one input line (and record it)
#   transcript SRC DST              append fixture SRC to DST (SRC relative to this
#                                   script's fixtures/agents dir unless absolute)
#   lines SRC FROM TO DST           append lines FROM..TO (1-based, inclusive) of SRC to DST
#   keys N                          read N raw bytes (no line editing, no echo) and record
#                                   them as one line "keys <hex> <hex> ..."
#   claude-session DIR ID CWD       act as a running Claude Code: write its session
#                                   registry entry DIR/sessions/<pid>.json (sessionId ID)
#   hold FILE                       keep FILE open (for appending) until exit, as Codex
#                                   keeps its rollout open; creates it and its directory
#   sleep SECONDS
#   say TEXT...                     print TEXT on the screen
#   appcursor                       ask for application cursor keys (DECCKM, CSI ?1h)
#   exit CODE
#   # ...                           comment
set -uf

script=${1:?usage: fake-agent SCRIPT}
log=${FAKE_AGENT_INPUT:-./fake-agent.input}
app=${FAKE_AGENT_APP:-fake}
fixtures=$(cd "$(dirname "$0")/.." && pwd)

report() {
    state=$1
    shift
    kind=-
    if [ $# -gt 0 ]; then
        kind=$1
        shift
    fi
    fields="state=$state"
    [ "$kind" != "-" ] && fields="$fields:kind=$kind"
    fields="$fields:app=$app"
    if [ $# -gt 0 ]; then
        fields="$fields:msg=$(printf '%s' "$*" | base64 | tr -d '\n')"
    fi
    printf '\033]7501;%s\033\\' "$fields"
}

record() {
    IFS= read -r line || exit 0
    printf '%s\n' "$line" >>"$log"
}

: >>"$log"
while IFS= read -r step <&3 || [ -n "$step" ]; do
    # shellcheck disable=SC2086
    set -- $step
    [ $# -eq 0 ] && continue
    cmd=$1
    shift
    case $cmd in
    \#*) ;;
    status) report "$@" ;;
    wait) record ;;
    transcript)
        src=$1
        case $src in /*) ;; *) src=$fixtures/$src ;; esac
        cat "$src" >>"$2"
        ;;
    lines)
        src=$1
        case $src in /*) ;; *) src=$fixtures/$src ;; esac
        sed -n "$2,$3p" "$src" >>"$4"
        ;;
    keys)
        saved=$(stty -g)
        stty raw -echo
        bytes=$(dd bs=1 count="$1" 2>/dev/null | od -An -tx1 | tr '\n' ' ' | tr -s ' ')
        stty "$saved"
        printf 'keys%s\n' "$bytes" | sed 's/ *$//' >>"$log"
        ;;
    claude-session)
        mkdir -p "$1/sessions"
        # starttime: field 22 of /proc/<pid>/stat, counted after the ")".
        start=$(sed 's/.*) //' /proc/$$/stat | cut -d' ' -f20)
        printf '{"pid":%s,"sessionId":"%s","cwd":"%s","procStart":"%s","kind":"interactive"}\n' \
            "$$" "$2" "$3" "$start" >"$1/sessions/$$.json.tmp"
        mv "$1/sessions/$$.json.tmp" "$1/sessions/$$.json"
        ;;
    hold)
        mkdir -p "$(dirname "$1")"
        exec 4>>"$1"
        ;;
    sleep) sleep "$1" ;;
    say) printf '%s\n' "$*" ;;
    appcursor) printf '\033[?1h' ;;
    exit) exit "$1" ;;
    *) printf 'fake-agent: unknown step: %s\n' "$step" >&2 ;;
    esac
done 3<"$script"

while :; do record; done
