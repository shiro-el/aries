<?xml version="1.0" encoding="utf-8"?>
<!-- Aries: Android 12 SplashScreen with the Aries mark. -->
<resources>
    <style name="Theme.Aries" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:colorAccent">@color/brand_saffron</item>
        <item name="android:windowSplashScreenBackground">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_ink</item>
    </style>
</resources>
